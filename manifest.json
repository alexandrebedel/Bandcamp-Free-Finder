{
	"manifest_version": 3,
	"name": "Free Download Finder for Bandcamp",
	"description": "Spot free downloads and name-your-price releases on Bandcamp label and artist pages, without opening each album.",
	"homepage_url": "https://github.com/alexandrebedel/free-download-finder-for-bandcamp",
	"version": "1.1.0",
	"permissions": ["storage"],
	"host_permissions": ["*://*.bandcamp.com/*"],
	"content_scripts": [
		{
			"matches": ["*://*.bandcamp.com/*"],
			"js": ["js/content.js"],
			"css": ["css/tokens.css", "css/band.css", "css/free-list.css"],
			"run_at": "document_idle"
		}
	],
	"action": {
		"default_title": "Free Download Finder for Bandcamp"
	},
	"background": {
		"service_worker": "js/bg.js",
		"type": "module"
	},
	"web_accessible_resources": [
		{
			"resources": ["js/content/*.js", "js/shared/*.js"],
			"matches": ["*://*.bandcamp.com/*"]
		}
	]
}
