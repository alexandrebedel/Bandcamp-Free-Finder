{
	"manifest_version": 3,
	"name": "Bandcamp Free Finder",
	"description": "Flags free and name-your-price releases on Bandcamp label and artist pages, without opening them.",
	"version": "1.1.0",
	"permissions": ["storage"],
	"host_permissions": ["*://*.bandcamp.com/*"],
	"content_scripts": [
		{
			"matches": ["*://*.bandcamp.com/*"],
			"js": ["js/content.js"],
			"css": ["css/badge.css"],
			"run_at": "document_idle"
		}
	],
	"action": {
		"default_title": "Bandcamp Free Finder"
	},
	"background": {
		"service_worker": "js/bg.js",
		"type": "module"
	}
}
